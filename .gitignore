# Python environment, caches and build output
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# IDPS runtime data. The app keeps these in ~/.netsentinel, but copies made with
# --db, --json-log or --save-pcap can end up in the project folder.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.pcap
*.pcapng
!samples/attacks.pcap
*.jsonl
netsentinel-crash.log
*.log

# Local secrets (webhook URLs, tokens) if you ever keep them in a file
.env
.env.*

# Local backups made before large changes
.backup/

# .kiro/ is committed on purpose: the README links to the specs in .kiro/specs.
